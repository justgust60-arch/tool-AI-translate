import os, re, json, wave, uuid, asyncio, shutil, subprocess, threading, time, urllib.request
from fastapi import FastAPI, UploadFile, File, Form, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import FileResponse
import uvicorn, edge_tts
import numpy as np

ROOT = "/content"
WORK = f"{ROOT}/work"
os.makedirs(WORK, exist_ok=True)
RATE = 24000
VOICES = {"male": "km-KH-PisethNeural", "female": "km-KH-SreymomNeural"}

app = FastAPI()
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])
jobs = {}


# ---------- job helpers (long tasks run in background, the web page polls) ----------
def run_job(fn, *args):
    jid = uuid.uuid4().hex[:10]
    jobs[jid] = {"status": "running", "progress": 0, "message": "", "result": None}

    def work():
        try:
            jobs[jid]["result"] = fn(jid, *args)
            jobs[jid].update(status="done", progress=100)
        except Exception as e:
            jobs[jid].update(status="error", message=str(e))

    threading.Thread(target=work, daemon=True).start()
    return {"job_id": jid}


def prog(jid, p, msg=""):
    jobs[jid]["progress"] = round(p, 1)
    jobs[jid]["message"] = msg


def resolve(name):
    p = os.path.realpath(os.path.join(ROOT, name.strip().lstrip("/")))
    if not p.startswith(ROOT + "/") or not os.path.isfile(p):
        raise HTTPException(404, "Video file not found in Colab: " + name)
    return p


def fmt(t):
    ms = int(round(t * 1000))
    h, ms = divmod(ms, 3600000)
    m, ms = divmod(ms, 60000)
    s, ms = divmod(ms, 1000)
    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"


@app.get("/api/job/{jid}")
def job(jid: str):
    if jid not in jobs:
        raise HTTPException(404, "job not found")
    return jobs[jid]


@app.get("/api/health")
def health():
    return {"ok": True}


# ---------- 1. upload ----------
@app.post("/api/upload")
async def upload(file: UploadFile = File(...)):
    ext = os.path.splitext(file.filename or "")[1] or ".mp4"
    name = f"work/up_{uuid.uuid4().hex[:8]}{ext}"
    with open(f"{ROOT}/{name}", "wb") as o:
        while True:
            chunk = await file.read(8 * 1024 * 1024)
            if not chunk:
                break
            o.write(chunk)
    return {"video": name}


# ---------- 2. real speech-to-text (Whisper) ----------
_model = None  # (model, "cuda" or "cpu")


def prepare_cuda():
    """Pre-load the CUDA 12 libraries installed by pip (Colab's own CUDA can be a newer version)."""
    import ctypes, glob, site
    roots = list(site.getsitepackages()) + [site.getusersitepackages()]
    for sub in ("cuda_runtime", "cublas", "cudnn"):
        for r in roots:
            for f in sorted(glob.glob(f"{r}/nvidia/{sub}/lib/*.so*")):
                try:
                    ctypes.CDLL(f, mode=ctypes.RTLD_GLOBAL)
                except OSError:
                    pass


def get_model(cpu=False):
    global _model
    if _model is None or (cpu and _model[1] != "cpu"):
        prepare_cuda()
        from faster_whisper import WhisperModel
        gpu = False
        if not cpu:
            try:
                import torch
                gpu = torch.cuda.is_available()
            except Exception:
                gpu = False
        if gpu:
            _model = (WhisperModel("large-v3", device="cuda", compute_type="float16"), "cuda")
        else:
            _model = (WhisperModel("small", device="cpu", compute_type="int8"), "cpu")
    return _model[0]


def load_audio(path):
    out = subprocess.run(
        ["ffmpeg", "-v", "error", "-i", path, "-ac", "1", "-ar", "16000", "-f", "f32le", "-"],
        capture_output=True, check=True).stdout
    return np.frombuffer(out, dtype=np.float32)


def run_whisper(jid, model, audio, lang):
    segs, info = model.transcribe(audio, language=(None if lang in ("", "auto") else lang), vad_filter=True)
    total = max(info.duration, 1)
    out = []
    for s in segs:
        t = s.text.strip()
        if not t:
            continue
        out.append({"id": len(out) + 1, "start": round(s.start, 3), "end": round(s.end, 3),
                    "time": f"{fmt(s.start)} - {fmt(s.end)}", "chinese": t, "khmer": ""})
        prog(jid, min(99, s.end / total * 100), f"{len(out)} lines")
    return out


def do_transcribe(jid, path, lang):
    prog(jid, 1, "Loading Whisper...")
    audio = load_audio(path)
    try:
        return run_whisper(jid, get_model(), audio, lang)
    except Exception as e:
        if not re.search(r"cublas|cudnn|libcu|cuda", str(e), re.I):
            raise
        prog(jid, 1, "GPU library problem -> using CPU (slower)")
        return run_whisper(jid, get_model(cpu=True), audio, lang)


@app.post("/api/transcribe")
async def transcribe(video: str = Form(...), language: str = Form("zh")):
    return run_job(do_transcribe, resolve(video), language)


# ---------- 3. real translation Chinese -> Khmer ----------
def do_translate(jid, texts):
    import time
    from deep_translator import GoogleTranslator
    tr = GoogleTranslator(source="zh-CN", target="km")
    out = []
    fails = 0
    for i, t in enumerate(texts):
        t = t.replace("\n", " ")
        res = None
        for k in range(3):
            try:
                res = tr.translate(t)
                break
            except Exception:
                time.sleep(1.5 * (k + 1))
        if not res:
            fails += 1
            res = ""
        out.append(res)
        time.sleep(0.25)
        prog(jid, len(out) / len(texts) * 100, f"{len(out)}/{len(texts)} (fails {fails})")
        if (fails >= 5 and fails == len(out)) or (fails >= 15 and fails > len(out) * 0.5):
            raise RuntimeError("Google Translate is blocking this IP. Wait a while or change runtime.")
    return out


@app.post("/api/translate")
async def translate(texts_json: str = Form(...)):
    return run_job(do_translate, json.loads(texts_json))


