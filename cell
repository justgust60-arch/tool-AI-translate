# ---------- 5. full dubbing ----------
def ff(*args):
    subprocess.run(["ffmpeg", "-y", "-v", "error", *args], check=True)


def decode(src, dst, tempo=1.0):
    a = ["-i", src, "-ac", "1", "-ar", str(RATE)]
    if tempo > 1.01:
        a += ["-filter:a", f"atempo={tempo:.3f}"]
    ff(*a, "-sample_fmt", "s16", dst)


def pcm(p):
    with wave.open(p, "rb") as w:
        return w.readframes(w.getnframes())


async def synth(items, d, jid, rate):
    sem, n = asyncio.Semaphore(6), 0

    async def one(i, it):
        nonlocal n
        f = f"{d}/c{i:05d}.mp3"
        async with sem:
            for k in range(4):
                if os.path.exists(f) and os.path.getsize(f) > 0:
                    break
                try:
                    await edge_tts.Communicate(it["text"], it["voice"], rate=f"{rate:+d}%").save(f)
                except Exception:
                    if os.path.exists(f):
                        os.remove(f)
                    await asyncio.sleep(1.5 * (k + 1))
        n += 1
        prog(jid, n / len(items) * 50, f"Voice {n}/{len(items)}")

    await asyncio.gather(*(one(i, it) for i, it in enumerate(items)))


def do_dub(jid, path, subs, gender, orig, rate, kvol):
    items = sorted(
        [{"start": float(s["start"]), "end": float(s["end"]),
          "text": re.sub(r"\s+", " ", s.get("khmer", "")).strip(),
          "voice": VOICES.get(s.get("gender") or gender, VOICES["female"])}
         for s in subs if s.get("khmer", "").strip()],
        key=lambda x: x["start"])
    if not items:
        raise ValueError("No Khmer text to dub")
    d = f"{WORK}/dub_{jid}"
    os.makedirs(d, exist_ok=True)
    asyncio.run(synth(items, d, jid, rate))

    tmp = f"{d}/t.wav"
    track = np.zeros(int((items[-1]["end"] + 15) * RATE), dtype=np.int32)
    for i, it in enumerate(items):
        mp3 = f"{d}/c{i:05d}.mp3"
        if not os.path.exists(mp3) or os.path.getsize(mp3) == 0:
            continue
        st = int(it["start"] * RATE)
        nxt = items[i + 1]["start"] if i + 1 < len(items) else it["end"] + 3
        slot = max(0.6, nxt - it["start"] + 0.3)
        decode(mp3, tmp)
        b = np.frombuffer(pcm(tmp), dtype=np.int16)
        dur = len(b) / RATE
        if dur > slot:
            decode(mp3, tmp, min(2.0, dur / slot))
            b = np.frombuffer(pcm(tmp), dtype=np.int16)
        if st + len(b) > len(track):
            track = np.pad(track, (0, st + len(b) - len(track)))
        track[st:st + len(b)] += b
        if i % 25 == 0:
            prog(jid, 50 + i / len(items) * 40, f"Building track {i + 1}/{len(items)}")
    wav = f"{d}/dub.wav"
    with wave.open(wav, "wb") as o:
        o.setnchannels(1)
        o.setsampwidth(2)
        o.setframerate(RATE)
        o.writeframes(np.clip(track, -32768, 32767).astype(np.int16).tobytes())
    del track

    if path.lower().endswith((".mp3", ".wav", ".m4a", ".aac", ".flac", ".ogg", ".opus")):
        prog(jid, 92, "Encoding Khmer voice track...")
        out = f"{WORK}/dubbed_{jid}.mp3"
        ff("-i", wav, "-filter:a", f"volume={kvol * 0.67:.2f},alimiter=limit=0.95", "-b:a", "96k", out)
        shutil.rmtree(d, ignore_errors=True)
        return {"file": os.path.basename(out)}

    prog(jid, 92, "Merging into video...")
    out = f"{WORK}/dubbed_{jid}.mp4"
    dv = kvol * 0.67  # UI default 300% ~= old fixed volume 2
    try:
        if orig <= 0:
            raise RuntimeError("no original audio wanted")
        ff("-i", path, "-i", wav, "-filter_complex",
           f"[0:a]volume={orig * 2}[o];[1:a]volume={dv:.2f}[d];"
           f"[o][d]amix=inputs=2:duration=first:dropout_transition=0,alimiter=limit=0.95[a]",
           "-map", "0:v:0", "-map", "[a]", "-c:v", "copy", "-c:a", "aac", "-b:a", "192k", out)
    except Exception:
        ff("-i", path, "-i", wav, "-filter_complex", f"[1:a]volume={dv:.2f},alimiter=limit=0.95[a]",
           "-map", "0:v:0", "-map", "[a]", "-c:v", "copy", "-c:a", "aac", "-b:a", "192k", "-shortest", out)
    shutil.rmtree(d, ignore_errors=True)
    return {"file": os.path.basename(out)}


@app.post("/api/dub")
async def dub(video: str = Form(...), subs_json: str = Form(...),
              gender: str = Form("female"), original_volume: float = Form(0.15),
              speech_rate: int = Form(15), khmer_volume: float = Form(3.0)):
    return run_job(do_dub, resolve(video), json.loads(subs_json), gender,
                   max(0.0, min(1.0, original_volume)), max(-20, min(60, speech_rate)),
                   max(1.0, min(6.0, khmer_volume)))


@app.get("/api/download/{name}")
def download(name: str):
    p = os.path.join(WORK, os.path.basename(name))
    if not os.path.isfile(p):
        raise HTTPException(404, "file not found")
    if p.endswith(".mp3"):
        return FileResponse(p, media_type="audio/mpeg", filename="khmer_voice.mp3")
    return FileResponse(p, media_type="video/mp4", filename="khmer_dubbed_movie.mp4")


