import os, re, json, wave, uuid, asyncio, shutil, subprocess, threading, time, urllib.request
import requests
from fastapi import FastAPI, UploadFile, File, Form, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import FileResponse
import uvicorn, edge_tts
import numpy as np

ROOT = "/content"
WORK = f"{ROOT}/work"
os.makedirs(WORK, exist_ok=True)
RATE = 24000
VOICES = {"male": "km-KH-PisethNeural", "female": "km-KH-SreymomNeural"}

app = FastAPI()
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])
jobs = {}


# ---------- job helpers ----------
def run_job(fn, *args):
    jid = uuid.uuid4().hex[:10]
    jobs[jid] = {"status": "running", "progress": 0, "message": "", "result": None}

    def work():
        try:
            jobs[jid]["result"] = fn(jid, *args)
            jobs[jid].update(status="done", progress=100)
        except Exception as e:
            jobs[jid].update(status="error", message=str(e))

    threading.Thread(target=work, daemon=True).start()
    return {"job_id": jid}


def prog(jid, p, msg=""):
    jobs[jid]["progress"] = round(p, 1)
    jobs[jid]["message"] = msg


def resolve(name):
    p = os.path.realpath(os.path.join(ROOT, name.strip().lstrip("/")))
    if not p.startswith(ROOT + "/") or not os.path.isfile(p):
        raise HTTPException(404, "Video file not found in Colab: " + name)
    return p


def fmt(t):
    ms = int(round(t * 1000))
    h, ms = divmod(ms, 3600000)
    m, ms = divmod(ms, 60000)
    s, ms = divmod(ms, 1000)
    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"


@app.get("/api/job/{jid}")
def job(jid: str):
    if jid not in jobs:
        raise HTTPException(404, "job not found")
    return jobs[jid]


@app.get("/api/health")
def health():
    return {"ok": True}


@app.get("/api/files")
def files():
    out = []
    for f in sorted(os.listdir(WORK)):
        p = os.path.join(WORK, f)
        if os.path.isfile(p) and f.endswith((".mp4", ".mp3")):
            out.append({"name": f, "mb": round(os.path.getsize(p) / 1e6, 1)})
    return out


# ---------- 1. upload (small file + chunked big file) ----------
@app.post("/api/upload")
async def upload(file: UploadFile = File(...)):
    ext = os.path.splitext(file.filename or "")[1] or ".mp4"
    name = f"work/up_{uuid.uuid4().hex[:8]}{ext}"
    with open(f"{ROOT}/{name}", "wb") as o:
        while True:
            chunk = await file.read(8 * 1024 * 1024)
            if not chunk:
                break
            o.write(chunk)
    return {"video": name}


def _safe_id(s):
    return re.sub(r"[^a-zA-Z0-9]", "", s)[:40] or "x"


@app.post("/api/upload_chunk")
async def upload_chunk(file: UploadFile = File(...), upload_id: str = Form(...), index: int = Form(...)):
    d = f"{WORK}/chunks_{_safe_id(upload_id)}"
    os.makedirs(d, exist_ok=True)
    with open(f"{d}/{int(index):05d}.part", "wb") as o:
        while True:
            chunk = await file.read(8 * 1024 * 1024)
            if not chunk:
                break
            o.write(chunk)
    return {"ok": True}


@app.post("/api/upload_done")
async def upload_done(upload_id: str = Form(...), total: int = Form(...), ext: str = Form(".mp4")):
    d = f"{WORK}/chunks_{_safe_id(upload_id)}"
    ext = ext if re.fullmatch(r"\.[a-zA-Z0-9]{1,5}", ext or "") else ".mp4"
    name = f"work/up_{uuid.uuid4().hex[:8]}{ext}"
    with open(f"{ROOT}/{name}", "wb") as o:
        for i in range(int(total)):
            part = f"{d}/{i:05d}.part"
            if not os.path.exists(part):
                raise HTTPException(400, f"missing chunk {i}")
            with open(part, "rb") as p:
                shutil.copyfileobj(p, o, 8 * 1024 * 1024)
    shutil.rmtree(d, ignore_errors=True)
    return {"video": name}


# ---------- 2. speech-to-text (Whisper) ----------
_model = None  # (model, "cuda" or "cpu")


def prepare_cuda():
    import ctypes, glob, site
    roots = list(site.getsitepackages()) + [site.getusersitepackages()]
    for sub in ("cuda_runtime", "cublas", "cudnn"):
        for r in roots:
            for f in sorted(glob.glob(f"{r}/nvidia/{sub}/lib/*.so*")):
                try:
                    ctypes.CDLL(f, mode=ctypes.RTLD_GLOBAL)
                except OSError:
                    pass


def get_model(cpu=False):
    global _model
    if _model is None or (cpu and _model[1] != "cpu"):
        prepare_cuda()
        from faster_whisper import WhisperModel
        gpu = False
        if not cpu:
            try:
                import torch
                gpu = torch.cuda.is_available()
            except Exception:
                gpu = False
        if gpu:
            _model = (WhisperModel("large-v3", device="cuda", compute_type="float16"), "cuda")
        else:
            _model = (WhisperModel("small", device="cpu", compute_type="int8"), "cpu")
    return _model[0]


def load_audio(path):
    out = subprocess.run(
        ["ffmpeg", "-v", "error", "-i", path, "-ac", "1", "-ar", "16000", "-f", "f32le", "-"],
        capture_output=True, check=True).stdout
    return np.frombuffer(out, dtype=np.float32)


def run_whisper(jid, model, audio, lang):
    segs, info = model.transcribe(audio, language=(None if lang in ("", "auto") else lang),
                                  vad_filter=True)
    total = max(info.duration, 1)
    out = []
    for s in segs:
        t = s.text.strip()
        if not t:
            continue
        out.append({"id": len(out) + 1, "start": round(s.start, 3), "end": round(s.end, 3),
                    "time": f"{fmt(s.start)} - {fmt(s.end)}", "chinese": t, "khmer": ""})
        prog(jid, min(99, s.end / total * 100), f"{len(out)} lines")
    return out


def do_transcribe(jid, path, lang):
    prog(jid, 1, "Loading Whisper...")
    audio = load_audio(path)
    try:
        return run_whisper(jid, get_model(), audio, lang)
    except Exception as e:
        if not re.search(r"cublas|cudnn|libcu|cuda", str(e), re.I):
            raise
        prog(jid, 1, "GPU library problem -> using CPU (slower)")
        return run_whisper(jid, get_model(cpu=True), audio, lang)


@app.post("/api/transcribe")
async def transcribe(video: str = Form(...), language: str = Form("auto")):
    return run_job(do_transcribe, resolve(video), language)


# ---------- 2b. male / female detection (pitch) ----------
def _f0(x, sr=16000):
    fl, hop = int(0.04 * sr), int(0.02 * sr)
    lo, hi = int(sr / 400), int(sr / 70)
    n = 1 << (2 * fl - 1).bit_length()
    vals = []
    for s in range(0, len(x) - fl, hop):
        f = x[s:s + fl].astype(np.float64)
        f = f - f.mean()
        if np.sqrt((f ** 2).mean()) < 0.01:
            continue
        sp = np.fft.rfft(f, n)
        ac = np.fft.irfft(sp * np.conj(sp))[:hi + 1]
        if ac[0] <= 0:
            continue
        k = lo + int(np.argmax(ac[lo:hi + 1]))
        if ac[k] / ac[0] > 0.4:
            vals.append(sr / k)
    return float(np.median(vals)) if len(vals) >= 3 else None


def do_detect(jid, path, segs):
    prog(jid, 1, "Loading audio...")
    audio = load_audio(path)
    sr, out = 16000, []
    for i, (a, b) in enumerate(segs):
        a, b = int(float(a) * sr), int(float(b) * sr)
        b = min(b, a + 4 * sr)
        f0 = _f0(audio[a:b]) if b > a else None
        out.append("" if f0 is None else ("male" if f0 < 165 else "female"))
        if i % 20 == 0:
            prog(jid, i / max(1, len(segs)) * 100, f"{i}/{len(segs)}")
    return out


@app.post("/api/detect_gender")
async def detect_gender(video: str = Form(...), segs_json: str = Form(...)):
    return run_job(do_detect, resolve(video), json.loads(segs_json))


# ---------- 3. translation (Edge Translate first, Google fallback) ----------
def _tr_edge(texts, token):
    r = requests.post("https://api-edge.cognitive.microsofttranslator.com/translate",
                      params={"to": "km", "api-version": "3.0"},
                      headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"},
                      json=[{"Text": t} for t in texts], timeout=60)
    r.raise_for_status()
    return [x["translations"][0]["text"] for x in r.json()]


def _tr_google(texts):
    out = []
    for t in texts:
        r = requests.get("https://translate.googleapis.com/translate_a/single",
                         params={"client": "gtx", "sl": "auto", "tl": "km", "dt": "t", "q": t}, timeout=20)
        r.raise_for_status()
        out.append("".join(p[0] for p in r.json()[0] if p[0]))
        time.sleep(0.3)
    return out


def do_translate(jid, texts):
    texts = [re.sub(r"\s+", " ", t).strip() or "." for t in texts]
    out, B = [], 40
    token, last_err = None, ""
    for i in range(0, len(texts), B):
        part = texts[i:i + B]
        res = None
        for attempt in range(3):
            try:
                if token is None:
                    token = requests.get("https://edge.microsoft.com/translate/auth", timeout=20).text
                res = _tr_edge(part, token)
                break
            except Exception as e:
                last_err = "Edge: " + str(e)
                token = None
                time.sleep(2 * (attempt + 1))
        if res is None:
            try:
                res = _tr_google(part)
            except Exception as e:
                raise RuntimeError("Translate failed. " + last_err + " | Google: " + str(e))
        out += res
        prog(jid, len(out) / len(texts) * 100, f"{len(out)}/{len(texts)}")
    return out


@app.post("/api/translate")
async def translate(texts_json: str = Form(...)):
    return run_job(do_translate, json.loads(texts_json))


