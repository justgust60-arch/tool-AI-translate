for line in proc.stdout:
    m = re.search(r"https://[a-z0-9-]+\.trycloudflare\.com", line)
    if m:
        url = m.group(0)
        break
    if time.time() - t0 > 90:
        break


def _drain():
    for _ in proc.stdout:
        pass


threading.Thread(target=_drain, daemon=True).start()

